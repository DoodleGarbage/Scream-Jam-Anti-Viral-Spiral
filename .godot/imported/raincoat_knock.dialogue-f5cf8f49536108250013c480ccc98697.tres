"1": {
&"character": "Raincoat",
&"id": "1",
&"next_id": "2",
&"static_id": "",
&"text": "The house's owner is right next to you.",
&"type": "dialogue"
},
"10": {
&"character": "Folly",
&"id": "10",
&"next_id": "11",
&"static_id": "",
&"text": "Why am I always awake when everyone is asleep? Even the ever vigilant Raincoat has to go to sleep before me.",
&"type": "dialogue"
},
"11": {
&"id": "11",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"12": {
&"id": "12",
&"next_id": "13",
&"type": "cue"
},
"13": {
&"character": "Raincoat",
&"id": "13",
&"next_id": "14",
&"static_id": "",
&"text": "I'm watching you. Don't do anything rash.",
&"type": "dialogue"
},
"14": {
&"id": "14",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"15": {
&"id": "15",
&"next_id": "16",
&"type": "cue"
},
"16": {
&"character": "Folly",
&"id": "16",
&"next_id": "17",
&"static_id": "",
&"text": "You didn't deserve that, Raincoat...",
&"type": "dialogue"
},
"17": {
&"id": "17",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"18": {
&"id": "18",
&"next_id": "19",
&"type": "cue"
},
"19": {
&"character": "$(#U!@#)",
&"id": "19",
&"next_id": "20",
&"static_id": "",
&"text": "The Hermit seeks you",
&"type": "dialogue"
},
"2": {
&"id": "2",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"20": {
&"id": "20",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"21": {
&"id": "21",
&"next_id": "22",
&"type": "cue"
},
"22": {
&"character": "Folly",
&"id": "22",
&"next_id": "23",
&"static_id": "",
&"text": "Look at what I've done. Raincoat is an unrecoverable mess because of me.",
&"type": "dialogue"
},
"23": {
&"id": "23",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"24": {
&"id": "24",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"3": {
&"id": "3",
&"next_id": "4",
&"type": "cue"
},
"4": {
&"character": "Folly",
&"id": "4",
&"next_id": "5",
&"static_id": "",
&"text": "Raincoat likes to watch things. Always keeping an eye out.",
&"type": "dialogue"
},
"5": {
&"id": "5",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
