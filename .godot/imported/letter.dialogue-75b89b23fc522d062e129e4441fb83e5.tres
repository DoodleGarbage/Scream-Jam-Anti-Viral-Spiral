"1": {
&"character": "Letter",
&"id": "1",
&"next_id": "2",
&"static_id": "",
&"text": "Dear Folly, I had a great time on our last hangout. I would love to meet you again sometime. I think that there's still hope for us.",
&"type": "dialogue"
},
"10": {
&"id": "10",
&"next_id": "11",
&"type": "cue"
},
"11": {
&"character": "Letter",
&"id": "11",
&"next_id": "12",
&"static_id": "",
&"text": "Dear Folly, ever since the car crash, I've despised every fiber of your being. You murdered my parents, and at my lowest, you used it to take everything I ever had, even my love. I'll never forgive you for what you've done. I hate you. I hate you.",
&"type": "dialogue"
},
"12": {
&"character": "Letter",
&"id": "12",
&"next_id": "13",
&"static_id": "",
&"text": "Signed, Mercury.",
&"type": "dialogue"
},
"13": {
&"id": "13",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"14": {
&"id": "14",
&"next_id": "15",
&"type": ""
},
"15": {
&"id": "15",
&"next_id": "16",
&"type": "cue"
},
"16": {
&"character": "Folly",
&"id": "16",
&"next_id": "17",
&"static_id": "",
&"text": "I love my friend.",
&"type": "dialogue"
},
"17": {
&"id": "17",
&"is_snippet": false,
&"next_id": "1",
&"next_id_after": "",
&"type": "goto"
},
"18": {
&"id": "18",
&"next_id": "19",
&"type": "cue"
},
"19": {
&"character": "Folly",
&"id": "19",
&"next_id": "20",
&"static_id": "",
&"text": "I miss my friend.",
&"type": "dialogue"
},
"2": {
&"character": "Letter",
&"id": "2",
&"next_id": "3",
&"static_id": "",
&"text": "Signed, Your BFF",
&"type": "dialogue"
},
"20": {
&"id": "20",
&"is_snippet": false,
&"next_id": "6",
&"next_id_after": "",
&"type": "goto"
},
"21": {
&"id": "21",
&"next_id": "22",
&"type": "cue"
},
"22": {
&"character": "Folly",
&"id": "22",
&"next_id": "23",
&"static_id": "",
&"text": "I did it again. Raincoat, Brawny, Mercury... Everyone meets the same fate around me.",
&"type": "dialogue"
},
"23": {
&"id": "23",
&"is_snippet": false,
&"next_id": "11",
&"next_id_after": "",
&"type": "goto"
},
"24": {
&"id": "24",
&"next_id": "25",
&"type": "cue"
},
"25": {
&"character": "Mercury",
&"id": "25",
&"next_id": "26",
&"static_id": "",
&"text": "I'm here to stay. And I'm going to make sure you regret what you did.",
&"type": "dialogue"
},
"26": {
&"id": "26",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"27": {
&"id": "27",
&"next_id": "28",
&"type": "cue"
},
"28": {
&"character": "Folly",
&"id": "28",
&"next_id": "29",
&"static_id": "",
&"text": "Mercury will never forgive me for what I did...",
&"type": "dialogue"
},
"29": {
&"character": "Mercury",
&"id": "29",
&"next_id": "30",
&"static_id": "",
&"text": "Not even the Hermit can save you. You're stuck here. Trapped by your own actions.",
&"type": "dialogue"
},
"3": {
&"id": "3",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"30": {
&"id": "30",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"31": {
&"id": "31",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"4": {
&"id": "4",
&"next_id": "5",
&"type": ""
},
"5": {
&"id": "5",
&"next_id": "6",
&"type": "cue"
},
"6": {
&"character": "Letter",
&"id": "6",
&"next_id": "7",
&"static_id": "",
&"text": "Dear Folly, with how that event went down, I'm going to have to put our friendship on pause. IT ISN'T OVER YET! I just think we need some space to cool off and get our heads back on right. We can go back to being friends right after.",
&"type": "dialogue"
},
"7": {
&"character": "Letter",
&"id": "7",
&"next_id": "8",
&"static_id": "",
&"text": "Signed, A Former Friend",
&"type": "dialogue"
},
"8": {
&"id": "8",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
