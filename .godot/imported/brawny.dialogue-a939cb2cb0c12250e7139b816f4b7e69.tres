&"character": "Brawny",
&"id": "13",
&"next_id": "14",
&"static_id": "",
&"text": "I can't let you near the library right now.",
&"type": "dialogue"
},
"14": {
&"character": "Folly",
&"id": "14",
&"next_id": "15",
&"static_id": "",
&"text": "Why? What did I do?",
&"type": "dialogue"
},
"15": {
&"character": "Brawny",
&"id": "15",
&"next_id": "16",
&"static_id": "",
&"text": "You know what you did.",
&"type": "dialogue"
},
