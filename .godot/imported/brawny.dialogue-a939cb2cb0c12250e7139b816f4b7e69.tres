&"id": "24",
&"next_id": "25",
&"static_id": "",
&"text": "sidjjf hasdbn ajqo asojid the woods gjsdjk ghbnsd rheeeeee jfiasdj",
&"type": "dialogue"
},
"25": {
&"character": "Folly",
&"id": "25",
&"next_id": "26",
&"static_id": "",
&"text": "I hope someone can help you..",
&"type": "dialogue"
},
