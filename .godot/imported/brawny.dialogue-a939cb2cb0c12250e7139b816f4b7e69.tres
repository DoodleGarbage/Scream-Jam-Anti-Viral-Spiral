&"id": "20",
&"next_id": "21",
&"static_id": "",
&"text": "Blurble gurgle glbfbgggfrrgglll blub glug glurg glurg blgklfdgdgggrr",
&"type": "dialogue"
},
"21": {
&"character": "Folly",
&"id": "21",
&"next_id": "22",
&"static_id": "",
&"text": "I'm sorry about what I did, please forgive me...",
&"type": "dialogue"
},
"22": {
&"id": "22",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
