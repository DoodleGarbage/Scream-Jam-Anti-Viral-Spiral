"6": {
&"character": "Brawny",
&"id": "6",
&"next_id": "7",
&"static_id": "",
&"text": "Things aren't like how they usually are. You better not have anything to do with this.",
&"type": "dialogue"
},
"7": {
&"character": "Folly",
&"id": "7",
&"next_id": "8",
&"static_id": "",
&"text": "I didn't do anything!",
&"type": "dialogue"
},
"8": {
&"character": "Brawny",
&"id": "8",
&"next_id": "9",
&"static_id": "",
&"text": "If you're causing trouble around town and I find out, you'll be sorry you did. You can pass now.",
&"type": "dialogue"
},
