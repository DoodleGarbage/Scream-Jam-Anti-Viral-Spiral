character_names = PackedStringArray("Folly", "Hermit")
first_cue = "0"
lines = {
"0": {
&"id": "0",
&"next_id": "1",
&"type": "cue"
},
"1": {
&"character": "Folly",
&"id": "1",
&"next_id": "2",
&"static_id": "",
&"text": "Hello? Anybody there?",
&"type": "dialogue"
},
"10": {
&"character": "Hermit",
&"id": "10",
&"next_id": "11",
&"static_id": "",
&"text": "And yet, do you see anyone awake now? This is our turf.",
&"type": "dialogue"
},
"11": {
&"id": "11",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"12": {
&"id": "12",
&"next_id": "13",
&"type": "cue"
},
"13": {
&"character": "Folly",
&"id": "13",
&"next_id": "14",
&"static_id": "",
&"text": "Do you know why Brawny and Raincoat are suspicious of me?",
&"type": "dialogue"
},
"14": {
&"character": "Hermit",
&"id": "14",
&"next_id": "15",
&"static_id": "",
&"text": "Yes.",
&"type": "dialogue"
},
"15": {
&"character": "Folly",
&"id": "15",
&"next_id": "16",
&"static_id": "",
&"text": "Will you tell me?",
&"type": "dialogue"
},
"16": {
&"character": "Hermit",
&"id": "16",
&"next_id": "17",
&"static_id": "",
&"text": "mmm. No. It will make things worse.",
&"type": "dialogue"
},
"17": {
&"character": "Folly",
&"id": "17",
&"next_id": "18",
&"static_id": "",
&"text": "Make things worse? How?",
&"type": "dialogue"
},
"18": {
&"character": "Hermit",
&"id": "18",
&"next_id": "19",
&"static_id": "",
&"text": "I've said too much already.",
&"type": "dialogue"
},
"19": {
&"id": "19",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"2": {
&"character": "Hermit",
&"id": "2",
&"next_id": "3",
&"static_id": "",
&"text": "What do you want?",
&"type": "dialogue"
},
"20": {
&"id": "20",
&"next_id": "21",
&"type": "cue"
},
"21": {
&"character": "Folly",
&"id": "21",
&"next_id": "22",
&"static_id": "",
&"text": "Hello again.",
&"type": "dialogue"
},
"22": {
&"character": "Hermit",
&"id": "22",
&"next_id": "23",
&"static_id": "",
&"text": "You know you aren't wanted here.",
&"type": "dialogue"
},
"23": {
&"character": "Folly",
&"id": "23",
&"next_id": "24",
&"static_id": "",
&"text": "You don't like me?",
&"type": "dialogue"
},
"24": {
&"character": "Hermit",
&"id": "24",
&"next_id": "25",
&"static_id": "",
&"text": "The others are the ones who don't like you. They glimpse what you are and it scares them.",
&"type": "dialogue"
},
"25": {
&"character": "Folly",
&"id": "25",
&"next_id": "26",
&"static_id": "",
&"text": "Are you scared of me?",
&"type": "dialogue"
},
"26": {
&"character": "Hermit",
&"id": "26",
&"next_id": "27",
&"static_id": "",
&"text": "...No. I was in your place once. Perhaps we're here to stay, forever and ever, stuck in an endless loop of sameness.",
&"type": "dialogue"
},
"27": {
&"id": "27",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"28": {
&"id": "28",
&"next_id": "29",
&"type": "cue"
},
"29": {
&"character": "Folly",
&"id": "29",
&"next_id": "30",
&"static_id": "",
&"text": "I did something awful!",
&"type": "dialogue"
},
"3": {
&"character": "Folly",
&"id": "3",
&"next_id": "4",
&"static_id": "",
&"text": "I wanted to introduce myself.",
&"type": "dialogue"
},
"30": {
&"character": "Hermit",
&"id": "30",
&"next_id": "31",
&"static_id": "",
&"text": "What did you do?",
&"type": "dialogue"
},
"31": {
&"character": "Folly",
&"id": "31",
&"next_id": "32",
&"static_id": "",
&"text": "I threw a stone at Brawny and killed him! Raincoat too!",
&"type": "dialogue"
},
"32": {
&"character": "Hermit",
&"id": "32",
&"next_id": "33",
&"static_id": "",
&"text": "...You haven't learned anything. Meet me tomorrow.",
&"type": "dialogue"
},
"33": {
&"id": "33",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"34": {
&"id": "34",
&"next_id": "35",
&"type": "cue"
},
"35": {
&"character": "Folly",
&"id": "35",
&"next_id": "36",
&"static_id": "",
&"text": "What do I do now? Everything I touch is falling apart!",
&"type": "dialogue"
},
"36": {
&"character": "Hermit",
&"id": "36",
&"next_id": "37",
&"static_id": "",
&"text": "It is time you left. If you stay any longer, you will be entrenched here, trapped in the cobwebs of doubt, like me.",
&"type": "dialogue"
},
"37": {
&"character": "Folly",
&"id": "37",
&"next_id": "38",
&"static_id": "",
&"text": "How do I leave?",
&"type": "dialogue"
},
"38": {
&"character": "Hermit",
&"id": "38",
&"next_id": "39",
&"static_id": "",
&"text": "Go home. I will help you tomorrow.",
&"type": "dialogue"
},
"39": {
&"id": "39",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"4": {
&"character": "Hermit",
&"id": "4",
&"next_id": "5",
&"static_id": "",
&"text": "I don't have time for that.",
&"type": "dialogue"
},
"40": {
&"id": "40",
&"next_id": "41",
&"type": "cue"
},
"41": {
&"id": "41",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"42": {
&"id": "42",
&"next_id": "43",
&"type": "cue"
},
"43": {
&"id": "43",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"44": {
&"id": "44",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"5": {
&"id": "5",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"6": {
&"id": "6",
&"next_id": "7",
&"type": "cue"
},
"7": {
&"character": "Folly",
&"id": "7",
&"next_id": "8",
&"static_id": "",
&"text": "Are you there?",
&"type": "dialogue"
},
"8": {
&"character": "Hermit",
&"id": "8",
&"next_id": "9",
&"static_id": "",
&"text": "Yes. We are creatures of the dark, after all.",
&"type": "dialogue"
},
"9": {
&"character": "Folly",
&"id": "9",
&"next_id": "10",
&"static_id": "",
&"text": "But I'm awake in the day.",
&"type": "dialogue"
}
}
metadata/dialogue_manager_version = "4.1.0"
