; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Another Day"
run/main_scene="uid://daug6eloobu1h"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0.30544716, 0.62893337, 0.70889413, 1)
boot_splash/image="uid://dcv38gaf14303"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=200

[autoload]

Status="*uid://crs2v42eoxbir"
Audio="*uid://bfb4kxuy4j2mk"
Dialogue="*uid://qh4gee4sbf1g"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[dialogue_manager]

editor/wrap_long_lines=true
editor/advanced/custom_test_scene_path="uid://bu634ku7mufa7"
editor/new_file_template="~ day1
=> END!
~ night1
=> END!
~ day2
=> END!
~ night2
=> END!
~ day3
=> END!
~ night3
=> END!
~ hell
=> END!"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Anti Viral Spiral"

[editor]

run/main_run_args="display/window/size/mode=3 %command%"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/heightmapmesh/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Scenes/": "green",
"res://Scripts/": "green"
}

